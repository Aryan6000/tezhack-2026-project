rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if requesting user is authenticated and has admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ── users collection ───────────────────────────────────────────────────────
    match /users/{uid} {
      // Authenticated users can read user profiles
      allow read: if request.auth != null;

      // User creates own profile on signup
      allow create: if request.auth != null && request.auth.uid == uid;

      // User can update own profile or Admin can update
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Only admin can delete user profiles
      allow delete: if isAdmin();
    }

    // ── complaints collection ──────────────────────────────────────────────────
    match /complaints/{id} {
      // Public feed, map, and tracking can read complaints
      allow read: if true;

      // Any authenticated citizen can submit a complaint
      allow create: if request.auth != null;

      // Authenticated citizens can update (upvote, add duplicates) or Admin can update status
      allow update: if request.auth != null;

      // Only admin can delete complaints
      allow delete: if isAdmin();

      // Subcollection: statusHistory
      match /statusHistory/{hid} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if isAdmin();
      }
    }
  }
}
